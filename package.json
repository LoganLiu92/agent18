{
  "name": "agent18",
  "version": "0.8.0",
  "private": true,
  "description": "Open-source support agent for SaaS: answer, act, and investigate safely",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "dev:console": "vite --config apps/console/vite.config.ts",
    "dev:identity": "tsx examples/identity-bridge/server.ts",
    "build": "pnpm typecheck && vite build --config apps/console/vite.config.ts && tsx scripts/build-sdk.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "tsx scripts/check-demo.ts && AGENT18_INTEGRATION=1 vitest run --config vitest.config.ts",
    "logs": "docker compose --env-file .local/compose.env -f deploy/compose/compose.yaml logs --tail=80",
    "demo:start": "tsx scripts/start-stack.ts demo",
    "demo:stop": "docker compose --env-file .local/compose.env -f deploy/compose/compose.yaml --profile demo --profile observability down",
    "test:policy": "docker run --rm -v \"$PWD/packages/policy/rego:/policy:ro\" openpolicyagent/opa:1.20.2-static@sha256:bb245e9e36be0d0ed486c240b606c56be7aba96014a4a87895fed4ba7a6dfa8d test /policy -v",
    "test:recovery": "tsx scripts/check-demo.ts && tsx scripts/verify-recovery.ts",
    "format": "prettier --write apps packages providers examples scripts tests *.json *.ts deploy/compose/*.yaml",
    "format:check": "prettier --check apps packages providers examples scripts tests *.json *.ts deploy/compose/*.yaml",
    "knowledge": "node --env-file-if-exists=.local/model.env --import tsx scripts/knowledge.ts",
    "demo:actions": "tsx scripts/enable-demo-actions.ts",
    "project:configure": "tsx scripts/project.ts",
    "setup:ui": "tsx apps/setup/src/main.ts",
    "start": "pnpm run setup && pnpm demo:start && pnpm setup:ui",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "restore": "tsx scripts/backup.ts restore",
    "release:check": "tsx scripts/release-check.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "docs:sync": "tsx scripts/docs-check.ts --write",
    "check": "pnpm format:check && pnpm docs:check && pnpm build && pnpm test && pnpm release:check",
    "deploy:prepare": "tsx scripts/deployment.ts",
    "deploy:start": "tsx scripts/start-stack.ts deploy",
    "restore:activate": "tsx scripts/backup.ts activate",
    "test:journey": "tsx scripts/journey.ts",
    "registry": "tsx scripts/registry.ts",
    "observability:demo": "tsx scripts/observability-demo.ts",
    "test:observability": "tsx scripts/check-demo.ts && tsx scripts/verify-observability.ts"
  },
  "dependencies": {
    "@agent18/actions": "workspace:*",
    "@agent18/application": "workspace:*",
    "@agent18/contracts": "workspace:*",
    "@agent18/domain": "workspace:*",
    "@agent18/knowledge": "workspace:*",
    "@agent18/knowledge-basic": "workspace:*",
    "@agent18/observability": "workspace:*",
    "@agent18/persistence": "workspace:*",
    "@agent18/policy": "workspace:*",
    "@agent18/provider-contracts": "workspace:*",
    "@agent18/web-sdk": "workspace:*",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "markdown-it": "14.3.2",
    "pg": "8.23.0",
    "pg-boss": "12.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
